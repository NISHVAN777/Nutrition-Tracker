# Copy this file to .env to change settings. Never commit .env.
# The default engine is free and needs no API key at all.

# Food recognition engine:
#   local (default) = free, self-hosted model (CLIP + classifier trained on free food datasets)
#   grok            = paid xAI Grok vision (needs XAI_API_KEY and credits)
AI_ENGINE=local

# Only needed when AI_ENGINE=grok
XAI_API_KEY=your-xai-key-here
XAI_MODEL=grok-4.20-0309-non-reasoning
PRICE_INPUT_PER_M=1.25
PRICE_OUTPUT_PER_M=2.50
DAILY_AI_LIMIT=40
MONTHLY_BUDGET_USD=3.00
PER_MINUTE_LIMIT=6
PORT=8787

# Phone access: set LAN_ACCESS=true to open NutriLens from your phone on the same Wi-Fi.
# Off by default (the server only listens on this computer).
LAN_ACCESS=false
# Required when LAN_ACCESS=true: at least 6 characters. Other devices must enter it once;
# this computer never needs it. The server refuses to start without it.
ACCESS_PIN=

# Optional: where the database and meal photos are stored (default: ./data)
# DATA_DIR=./data
