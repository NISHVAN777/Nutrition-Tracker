{
  "name": "NutriLens: AI Nutrition Tracker",
  "short_name": "NutriLens",
  "description": "Snap a photo of your food and get its nutrition, explained simply.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
